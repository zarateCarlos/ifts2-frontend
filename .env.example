# Instagram: en producción el token vive en Render (META_*), NO en Vite.
# Ver docs/META-TOKEN-60-DIAS.md. Estas VITE_* son solo demo sin backend.
VITE_INSTAGRAM_ID=
VITE_INSTAGRAM_APP_ID=
VITE_INSTAGRAM_ACCESS_TOKEN=

# Backend IFTS 2. Vacío = mock localStorage (maqueta).
# Producción: https://ifts2-backend.onrender.com
# Swagger: https://ifts2-backend.onrender.com/swagger-ui/index.html
VITE_API_BASE_URL=https://ifts2-backend.onrender.com

# Supabase (opcional): uso real de Storage vía Edge Function `storage-usage`
# cuando el proyecto esté ACTIVE. Sin esto, el medidor estima desde el CMS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=